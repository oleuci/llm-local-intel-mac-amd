<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- OPTIONAL, not installed by install.sh. Image generation: stable-diffusion.cpp (Vulkan/MoltenVK) + Z-Image-Turbo.
     --offload-to-cpu: weights stay in RAM and move to the GPU only while an image is generated (VRAM left to the LLM).
     APIs on 127.0.0.1:8093: AUTOMATIC1111 (/sdapi/v1/txt2img) and OpenAI (/v1/images/generations).
     Install: see extras/image-generation/README.md -->
<plist version="1.0"><dict>
 <key>Label</key><string>com.sdcpp.server</string>
 <key>ProgramArguments</key><array>
  <string>__HOME__/.local/share/sd-vk/sd-server</string>
  <string>--diffusion-model</string><string>__HOME__/models/sd/z_image_turbo-Q4_K.gguf</string>
  <string>--vae</string><string>__HOME__/models/sd/flux_ae.safetensors</string>
  <string>--llm</string><string>__HOME__/models/sd/Qwen3-4B-Instruct-2507-Q4_K_M.gguf</string>
  <string>--offload-to-cpu</string>
  <string>--cfg-scale</string><string>1.0</string><string>--steps</string><string>8</string>
  <string>-l</string><string>127.0.0.1</string><string>--listen-port</string><string>8093</string>
 </array>
 <key>WorkingDirectory</key><string>__HOME__/.local/share/sd-vk</string>
 <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
 <key>StandardOutPath</key><string>__HOME__/Library/Logs/sd-server/server.log</string>
 <key>StandardErrorPath</key><string>__HOME__/Library/Logs/sd-server/server.log</string>
</dict></plist>
