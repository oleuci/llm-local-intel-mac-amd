<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- llama-server in ROUTER mode: several models behind 127.0.0.1:8080, one loaded on the GPU at a time.
     Models and per-model settings: llama/models.ini, rendered to ~/.local/share/llama-vk/models.ini
     by scripts/install-services.sh. -->
<plist version="1.0"><dict>
 <key>Label</key><string>com.llamacpp.vulkan</string>
 <key>ProgramArguments</key><array>
  <string>__HOME__/.local/share/llama-vk/bin/llama-server</string>
  <string>--models-preset</string><string>__HOME__/.local/share/llama-vk/models.ini</string>
  <string>--models-max</string><string>1</string>
  <string>--host</string><string>127.0.0.1</string><string>--port</string><string>8080</string>
 </array>
 <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
 <key>StandardOutPath</key><string>__HOME__/Library/Logs/llama-vk/server.log</string>
 <key>StandardErrorPath</key><string>__HOME__/Library/Logs/llama-vk/server.log</string>
</dict></plist>
