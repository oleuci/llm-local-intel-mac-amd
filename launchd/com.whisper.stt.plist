<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
 <key>Label</key><string>com.whisper.stt</string>
 <key>ProgramArguments</key><array>
  <string>__HOME__/.local/share/uv/tools/open-webui/bin/python</string>
  <string>-I</string>
  <string>__REPO__/stt/whisper_server.py</string>
 </array>
 <key>EnvironmentVariables</key><dict>
  <key>PORT</key><string>8092</string>
  <key>WHISPER_DEFAULT_MODEL</key><string>large-v3-turbo</string>
  <key>WHISPER_THREADS</key><string>8</string>
  <key>HF_HUB_OFFLINE</key><string>1</string>
 </dict>
 <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
 <key>StandardOutPath</key><string>__HOME__/Library/Logs/whisper-stt/server.log</string>
 <key>StandardErrorPath</key><string>__HOME__/Library/Logs/whisper-stt/server.log</string>
</dict></plist>
